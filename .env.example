# -----------------------------------------------------------------------------
# AdLoop configuration. Copy to `.env` (gitignored) and fill in the key:
#     cp .env.example .env
# Every variable is optional except the API key; without a key AdLoop runs in
# mock mode (synthetic assets, fully offline) so the UI always works.
# On HF Spaces / Cloud Run / Render set these as platform secrets / env vars
# instead of shipping a .env file.
# -----------------------------------------------------------------------------

# --- Credentials --------------------------------------------------------------
GEMINI_API_KEY=
# Fallback name, used only if GEMINI_API_KEY is empty.
# GOOGLE_API_KEY=

# --- Mode ---------------------------------------------------------------------
# 1 = force mock mode even with a key (demo safety net / offline development).
ADLOOP_MOCK=0
# Multiplier on mock latencies (0.1 = ten times faster; handy for tests).
ADLOOP_MOCK_SPEED=1.0

# --- Models (defaults shown; override when preview ids change) -----------------
ADLOOP_MODEL_TEXT=gemini-3.8-flash                # creative director, judge, edit interpreter
ADLOOP_MODEL_IMAGE=gemini-3.1-flash-lite-image    # Nano Banana 2 Lite: storyboard + localization
ADLOOP_MODEL_VIDEO=gemini-omni-1.1-flash          # Omni Flash: image-to-video + conversational edits
ADLOOP_MODEL_MUSIC=lyria-3.5                      # Lyria: adaptive soundtrack
ADLOOP_MODEL_TRANSCRIBE=gemini-3.5-transcribe     # voice brief transcription

# --- Throughput: per-modality concurrency (semaphores inside GenMedia) ---------
ADLOOP_IMAGE_CONCURRENCY=8
ADLOOP_VIDEO_CONCURRENCY=4
ADLOOP_TEXT_CONCURRENCY=6
ADLOOP_MUSIC_CONCURRENCY=3
# Upper bound (s) for one non-video request (image / text / music / transcribe).
ADLOOP_REQUEST_TIMEOUT_SECONDS=150

# --- Video defaults ------------------------------------------------------------
ADLOOP_VIDEO_RESOLUTION=720p                      # 360p | 720p | 1080p
ADLOOP_VIDEO_SECONDS=6                            # default clip length per scene
ADLOOP_VIDEO_POLL_SECONDS=3.0                     # interactions / operation poll interval
ADLOOP_VIDEO_TIMEOUT_SECONDS=420                  # give up on a single render after this

# --- Judge tournament -----------------------------------------------------------
ADLOOP_JUDGE_THRESHOLD=7.0                        # repair round if best overall score < threshold
ADLOOP_MAX_REPAIR_ROUNDS=1

# --- Public-demo hardening --------------------------------------------------------
ADLOOP_MAX_CONCURRENT_RUNS=3                      # runs executing at once (server-wide)
ADLOOP_RUNS_PER_IP_PER_HOUR=6                     # 0 = unlimited
# Run id replayed by "Watch sample run" (/api/showcase). Empty = newest finished run.
ADLOOP_SHOWCASE_RUN=

# --- Media ---------------------------------------------------------------------
# 1 = keep Omni's generated clip audio in the final cut (mixed at 0.35 under the score).
ADLOOP_KEEP_CLIP_AUDIO=0

# --- API path pinning (skip capability probing for a role) -------------------------
# By default every adapter probes: Interactions API first, then the legacy path,
# and remembers what worked. Pin a role once scripts/smoke_test.py has told you
# the right answer. Values: interactions | generate_content | generate_videos (video only).
# ADLOOP_TEXT_PATH=generate_content
# ADLOOP_IMAGE_PATH=interactions
# ADLOOP_VIDEO_PATH=interactions
# ADLOOP_MUSIC_PATH=interactions
# ADLOOP_TRANSCRIBE_PATH=interactions

# --- Filesystem ------------------------------------------------------------------
# Run folders (run.json, events.jsonl, assets). Default: ./data/runs
# ADLOOP_DATA_DIR=/data/runs
